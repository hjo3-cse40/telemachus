# Telemachus Local Environment & Secrets Template
# Copy this file to .env and fill in your values.
# .env is strictly git-ignored to prevent credential leaks.

# Yahoo Mail (Initial Test Account)
TELEMACHUS_MAIL_YAHOO_USER=your_yahoo_email@yahoo.com
TELEMACHUS_MAIL_YAHOO_PASS=your_16_char_app_password

# Gmail Accounts (Fill these in when ready to enable)
# TELEMACHUS_MAIL_GMAIL1_USER=account1@gmail.com
# TELEMACHUS_MAIL_GMAIL1_PASS=your_gmail1_app_password
# TELEMACHUS_MAIL_GMAIL2_USER=account2@gmail.com
# TELEMACHUS_MAIL_GMAIL2_PASS=your_gmail2_app_password
# TELEMACHUS_MAIL_GMAIL3_USER=account3@gmail.com
# TELEMACHUS_MAIL_GMAIL3_PASS=your_gmail3_app_password
# TELEMACHUS_MAIL_GMAIL4_USER=account4@gmail.com
# TELEMACHUS_MAIL_GMAIL4_PASS=your_gmail4_app_password

# Laya Model Runtime
LAYA_PYTHON=/path/to/laya/.venv/bin/python
