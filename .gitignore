# ==============================================================================
# Telemachus: Local Agent Workflow Git Ignore
# Protects private personal data, mail tokens, ledgers, caches, and credentials
# ==============================================================================

# OS & Environment
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Secrets, Environment & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
token.json
client_secrets.json

# Private Personal Data & Storage
private/
data/private/
data/synthetic_fs/
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
data/*.jsonl
*.jsonl

# Email Cache & Mailbox Dumps
email_cache/
mailboxes/
*.eml
*.mbox

# Personal Financial Data & Records
finances/private/
*.beancount
*.ledger
*.hledger
*.csv
*.tsv
*.xlsx
*.pdf

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Bun
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OpenCode & Local AI Artifacts
.opencode/
*.dat
*.session.json
*.transcript.jsonl
*.index
*.faiss
chroma_db/
vector_store/
tmp/
scratch/
